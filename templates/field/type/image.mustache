{{!
    @template local_mb2megamenu/field/type/image
}}

{{{label}}}

<div class="form-controls">
    <div class="form-preview"></div>

    <div class="form-buttons">
        <button type="button"
                class="mb2-pb-btn typesuccess sizexs mb2megamenu-activate-option"
                data-modal="#mb2megamenu-modal-images">
            {{#str}}select{{/str}}
        </button>

        <button type="button"
                class="mb2megamenu-fieldremove mb2-pb-btn typedanger sizexs">
            {{#str}}remove{{/str}}
        </button>
    </div>

    <input type="hidden"
           class="mb2megamenu-input form-control input-{{type}} form-{{type}}"
           name="{{id}}"
           data-value="{{default}}">
</div>
