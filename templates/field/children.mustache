{{!
    @template local_mb2megamenu/field/children
}}

<div class="form-children-controls level-{{levelcls}}">
    {{#children}}
        {{#islabel}}
            <div class="form-child-label">{{content}}:</div>
        {{/islabel}}

        {{^islabel}}
            <div class="form-twin-control">
                <span class="form-twin-label">{{label}}:</span>
                <input type="text"
                       class="mb2megamenu-input mb2color input-{{type}}"
                       name="{{id}}"
                       data-value="{{default}}">
            </div>
        {{/islabel}}
    {{/children}}
</div>
