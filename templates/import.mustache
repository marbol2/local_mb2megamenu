{{!
    @template local_mb2megamenu/import
}}

<div class="mb2megamenu-menu-import">
    <button type="button" class="themereset mb2megamenu-import-header">
        {{#str}}importmenu, local_mb2megamenu{{/str}}
    </button>

    <div class="mb2megamenu-import-items">
        {{#menus}}
            <div class="mb2megamenu-import-item">
                <div class="item-name">{{name}}</div>

                <button type="button"
                        class="mb2-pb-btn typesuccess sizexs rounded1 noaction"
                        data-id="{{id}}">
                    <span class="import">{{#str}}import, local_mb2megamenu{{/str}}</span>
                    <span class="importing" aria-hidden="true">{{#str}}importing, local_mb2megamenu{{/str}}</span>
                    <span class="importdone" aria-hidden="true">{{#str}}importdone, local_mb2megamenu{{/str}}</span>
                </button>
            </div>
        {{/menus}}
    </div>
</div>
