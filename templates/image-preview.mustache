{{!
    @template local_mb2megamenu/image-preview
}}

{{#images}}
    <div class="mb2megamenu-image-toinsert"
         data-imgname="{{filename}}"
         data-simgname="{{searchname}}">

        <button type="button" class="themereset imgremove">&times;</button>

        <button type="button"
                class="themereset mb2megamenu-insert-image"
                data-imgurl="{{url}}">
            <img src="{{previewurl}}" alt="{{filename}}">
            <span class="imgdesc">{{filename}}</span>
        </button>
    </div>
{{/images}}
