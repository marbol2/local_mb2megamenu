{{!
    @template local_mb2megamenu/icon-tabs
}}

<div class="mb2megamenu-icon-tabs theme-tabs tabs-sm">
    <ul class="nav nav-tabs">
        {{#tabs}}
            <li class="nav-item{{#active}} active{{/active}}">
                <a class="nav-link{{#active}} active{{/active}}"
                   data-toggle="tab"
                   data-bs-toggle="tab"
                   href="#{{tabid}}">
                    {{name}}
                </a>
            </li>
        {{/tabs}}
    </ul>

    <div class="tab-content">
        {{#panes}}
            <div id="{{tabid}}" class="tab-pane fade{{#active}} in active{{/active}}">
                <div class="search-modal-item">
                    <input type="text"
                           class="mb2megamenu-search-icon"
                           placeholder="{{searchplaceholder}}">
                </div>

                <div class="mb2megamenu-icons">
                    {{#icons}}
                        <button type="button"
                                class="mb2megamenu-icon-toinsert themereset"
                                data-iconname="{{iconname}}"
                                title="{{iconname}}"
                                data-dismiss="mb2modal">
                            <i class="{{iconname}}"></i>
                        </button>
                    {{/icons}}
                </div>
            </div>
        {{/panes}}
    </div>
</div>
