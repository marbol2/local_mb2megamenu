{{!
    @template local_mb2megamenu/builder/modal
}}

<div id="mb2megamenu-modal-{{type}}"
     class="mb2megamenu-modal"
     role="dialog"
     data-lang="{{lang}}"
     data-islangopt="{{islangopt}}">

    <div class="mb2megamenu-modal-dialog modal-{{size}}" role="document">
        <div class="mb2megamenu-modal-content">

            <div class="mb2megamenu-modal-header d-flex flex-row justify-content-between align-items-center">
                <h5 class="mb2megamenu-modal-title m-0">{{title}}</h5>

                <button type="button" class="close" data-dismiss="mb2modal">&times;</button>
            </div>

            <div class="mb2megamenu-modal-body position-relative p-4">
                {{{content}}}
            </div>

            <div class="mb2megamenu-modal-footer d-flex flex-row justify-content-between align-items-center">
                {{#footerbuttons}}
                    <button type="button"
                            class="{{class}}"
                            {{#id}}id="{{id}}"{{/id}}
                            {{#dismiss}}data-dismiss="{{dismiss}}"{{/dismiss}}
                            {{#modal}}data-modal="{{modal}}"{{/modal}}>
                        {{label}}
                    </button>
                {{/footerbuttons}}
            </div>

        </div>
    </div>
</div>
