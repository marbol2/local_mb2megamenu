{{!
    @template local_mb2megamenu/builder/menu
}}

{{{languageel}}}

<div class="mb2megamenu-builder-wrap">
    <div class="mb2megamenu-builder-area">
        <div class="mb2megamenu-sortable mb2megamenu-main-sortable">
            {{#hasitems}}
                {{> local_mb2megamenu/builder/menu-items }}
            {{/hasitems}}
        </div>
    </div>
    <div class="mb2megamenu-builder-footer">
        <button id="mb2megamenu-add-menu-item" type="button" class="mb2-pb-btn typesuccess sizexs">
            {{additem}}
        </button>
    </div>
</div>
